pub impl fn lies_zaehler(welcher : u32 in 0 .. 15) -> u32
    effects { reads GESAMT, reads VERWORFEN, reads AKZEPTIERT, reads ABGEWIESEN,
              reads FEHLFORM, reads VOLL, reads REGELSUMME }
    costs <= 32 ops
{
    if welcher == 0 {
        let n0 : u32 = GESAMT;
        return n0;
    } else {
        if welcher == 1 {
            let n1 : u32 = VERWORFEN;
            return n1;
        } else {
            if welcher == 2 {
                let n2 : u32 = AKZEPTIERT;
                return n2;
            } else {
                if welcher == 3 {
                    let n3 : u32 = ABGEWIESEN;
                    return n3;
                } else {
                    if welcher == 4 {
                        let n4 : u32 = FEHLFORM;
                        return n4;
                    } else {
                        if welcher == 5 {
                            let n5 : u32 = VOLL;
                            return n5;
                        } else {
                            if welcher == 6 {
                                let n6 : u32 = REGELSUMME;
                                return n6;
                            } else {
                                if welcher == 7 {
                                    return 0;
                                } else {
                                    if welcher == 8 {
                                        return 0;
                                    } else {
                                        if welcher == 9 {
                                            return 0;
                                        } else {
                                            if welcher == 10 {
                                                return 0;
                                            } else {
                                                if welcher == 11 {
                                                    return 0;
                                                } else {
                                                    if welcher == 12 {
