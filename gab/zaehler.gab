impl fn folge(x : u32) -> u32
    effects { pure }
    costs <= 2 ops
{
    return x +% 1;
}

-- Contention exit: diverging, as the bounded loop demands.
extern fn zaehler_streit() -> never effects { diverges };

impl fn ink_gesamt() -> u32
    effects { reads GESAMT, writes GESAMT }
    costs <= 5 ops
{
    let alt_gesamt : u32 = GESAMT exchange update(t)
        bounded 64 ops
        on_exceeded zaehler_streit
    { return folge(t); } publishes nothing;
    return alt_gesamt;
}

