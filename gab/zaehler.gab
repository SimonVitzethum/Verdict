pub impl fn zaehle_urteil(u : u32 in 0 .. 2)
    effects { reads VERWORFEN, writes VERWORFEN, reads AKZEPTIERT, writes AKZEPTIERT,
              reads ABGEWIESEN, writes ABGEWIESEN, reads GESAMT, writes GESAMT }
    costs <= 14 ops
{
    if u == 0 {
        ink_verworfen();
    } else {
        if u == 1 {
            ink_akzeptiert();
        } else {
            ink_abgewiesen();
        }
    }
    ink_gesamt();
}

