L109, reads REGEL110, writes REGEL110, reads REGEL111, writes REGEL111, reads REGEL112, writes REGEL112, reads REGEL113, writes REGEL113, reads REGEL114, writes REGEL114, reads REGEL115, writes REGEL115, reads REGEL116, writes REGEL116, reads REGEL117, writes REGEL117, reads REGEL118, writes REGEL118, reads REGEL119, writes REGEL119, reads REGEL120, writes REGEL120, reads REGEL121, writes REGEL121, reads REGEL122, writes REGEL122, reads REGEL123, writes REGEL123, reads REGEL124, writes REGEL124, reads REGEL125, writes REGEL125, reads REGEL126, writes REGEL126, reads REGEL127, writes REGEL127, reads REGEL128, writes REGEL128, reads REGEL129, writes REGEL129, reads REGEL130, writes REGEL130, reads REGEL131, writes REGEL131, reads REGEL132, writes REGEL132, reads REGEL133, writes REGEL133, reads REGEL134, writes REGEL134, reads REGEL135, writes REGEL135, reads REGEL136, writes REGEL136, reads REGEL137, writes REGEL137, reads REGEL138, writes REGEL138, reads REGEL139, writes REGEL139, reads REGEL140, writes REGEL140, reads REGEL141, writes REGEL141, reads REGEL142, writes REGEL142, reads REGEL143, writes REGEL143, reads REGEL144, writes REGEL144, reads REGEL145, writes REGEL145, reads REGEL146, writes REGEL146, reads REGEL147, writes REGEL147, reads REGEL148, writes REGEL148, reads REGEL149, writes REGEL149, reads REGEL150, writes REGEL150, reads REGEL151, writes REGEL151, reads REGEL152, writes REGEL152, reads REGEL153, writes REGEL153, reads REGEL154, writes REGEL154, reads REGEL155, writes REGEL155, reads REGEL156, writes REGEL156, reads REGEL157, writes REGEL157, reads REGEL158, writes REGEL158, reads REGEL159, writes REGEL159, reads REGEL160, writes REGEL160, reads REGEL161, writes REGEL161, reads REGEL162, writes REGEL162, reads REGEL163, writes REGEL163, reads REGEL164, writes REGEL164, reads REGEL165, writes REGEL165, reads REGEL166, writes REGEL166, reads REGEL167, writes REGEL167, reads REGEL168, writes REGEL168, reads REGEL169, writes REGEL169, reads REGEL170, writes REGEL170, reads REGEL171, writes REGEL171, reads REGEL172, writes REGEL172, reads REGEL173, writes REGEL173, reads REGEL174, writes REGEL174, reads REGEL175, writes REGEL175, reads REGEL176, writes REGEL176, reads REGEL177, writes REGEL177, reads REGEL178, writes REGEL178, reads REGEL179, writes REGEL179, reads REGEL180, writes REGEL180, reads REGEL181, writes REGEL181, reads REGEL182, writes REGEL182, reads REGEL183, writes REGEL183, reads REGEL184, writes REGEL184, reads REGEL185, writes REGEL185, reads REGEL186, writes REGEL186, reads REGEL187, writes REGEL187, reads REGEL188, writes REGEL188, reads REGEL189, writes REGEL189, reads REGEL190, writes REGEL190, reads REGEL191, writes REGEL191, reads REGEL192, writes REGEL192, reads REGEL193, writes REGEL193, reads REGEL194, writes REGEL194, reads REGEL195, writes REGEL195, reads REGEL196, writes REGEL196, reads REGEL197, writes REGEL197, reads REGEL198, writes REGEL198, reads REGEL199, writes REGEL199, reads REGEL200, writes REGEL200, reads REGEL201, writes REGEL201, reads REGEL202, writes REGEL202, reads REGEL203, writes REGEL203, reads REGEL204, writes REGEL204, reads REGEL205, writes REGEL205, reads REGEL206, writes REGEL206, reads REGEL207, writes REGEL207, reads REGEL208, writes REGEL208, reads REGEL209, writes REGEL209, reads REGEL210, writes REGEL210, reads REGEL211, writes REGEL211, reads REGEL212, writes REGEL212, reads REGEL213, writes REGEL213, reads REGEL214, writes REGEL214, reads REGEL215, writes REGEL215, reads REGEL216, writes REGEL216, reads REGEL217, writes REGEL217, reads REGEL218, writes REGEL218, reads REGEL219, writes REGEL219, reads REGEL220, writes REGEL220, reads REGEL221, writes REGEL221, reads REGEL222, writes REGEL222, reads REGEL223, writes REGEL223, reads REGEL224, writes REGEL224, reads REGEL225, writes REGEL225, reads REGEL226, writes REGEL226, reads REGEL227, writes REGEL227, reads REGEL228, writes REGEL228, reads REGEL229, writes REGEL229, reads REGEL230, writes REGEL230, reads REGEL231, writes REGEL231, reads REGEL232, writes REGEL232, reads REGEL233, writes REGEL233, reads REGEL234, writes REGEL234, reads REGEL235, writes REGEL235, reads REGEL236, writes REGEL236, reads REGEL237, writes REGEL237, reads REGEL238, writes REGEL238, reads REGEL239, writes REGEL239, reads REGEL240, writes REGEL240, reads REGEL241, writes REGEL241, reads REGEL242, writes REGEL242, reads REGEL243, writes REGEL243, reads REGEL244, writes REGEL244, reads REGEL245, writes REGEL245, reads REGEL246, writes REGEL246, reads REGEL247, writes REGEL247, reads REGEL248, writes REGEL248, reads REGEL249, writes REGEL249, reads REGEL250, writes REGEL250, reads REGEL251, writes REGEL251, reads REGEL252, writes REGEL252, reads REGEL253, writes REGEL253, reads REGEL254, writes REGEL254, reads REGEL255, writes REGEL255, reads REGELSUMME, writes REGELSUMME, reads FEHLFORM, writes FEHLFORM, reads VOLL, writes VOLL }
{
    -- The C driver stands outside the range system: the emitted signature
    -- takes plain uint32_t, so a wild thread id would arrive unchecked.
    -- `faden` has no per-thread buffer to index (Kopf count 1 -- see
    -- BEFUNDE-bm8.md F4), hence this check is its only use, and the counting
    -- invariant (exactly one `zaehle_urteil` per call) holds even here.
    if faden > 15 {
        zaehle_urteil(DROP);
        return DROP;
    }
    -- 1. Decode. Malformed: count it twice (FEHLFORM for the event,
    --    DROP for the verdict so GESAMT stays per-packet) and drop.
    --    No rule is consulted for a packet we could not read.
    let ok : u32 in 0 .. 1 = entpacke(laenge);
    if ok == 0 {
        zaehle_fehl();
        zaehle_urteil(DROP);
        return DROP;
    }
    -- 2. The tuple, read through the accessors AFTER the single Kopf write
    --    of this call (V4): every read below is fresh, and no later call on
    --    this path writes Kopf, so no name here can go stale (M147).
    let proto : u32 in 0 .. 255 = gib_kopf_proto();
    let quelle : u32 = gib_kopf_quelle();
    let ziel : u32 = gib_kopf_ziel();
    let qport : u32 in 0 .. 65535 = gib_kopf_qport();
    let zport : u32 in 0 .. 65535 = gib_kopf_zport();
    let flaggen : u32 in 0 .. 255 = gib_kopf_flaggen();
    -- The flow direction: the local half of the ARCHITEKTUR.md key rule
    -- (smaller (address, port) first, so both directions hash to one
    -- bucket). This MUST match `suche_oder_lege_an` line for line -- it is
    -- how the fast path below knows which ESTABLISHED answer it can trust.
    let mut richtung : u32 = 0;
    if quelle > ziel {
        richtung = 1;
    } else {
        if quelle == ziel {
            if qport > zport {
                richtung = 1;
            }
        }
    }
    -- 3. Flow lookup under the connection lock. The block holds exactly
    --    the lookup and its assignment: rule matching and counting stay
    --    outside the critical section (the rule table is read-only after
    --    startup, the counters are lock-free atomics).
    let jetzt : u32 = tick();
    let mut zustand : u32 in 0 .. 3 = FREI;
    locks VSPERRE {
        zustand = suche_oder_lege_an(quelle, ziel, qport, zport, proto, flaggen, jetzt);
    }
    -- 4. Fast path, repaired (F5). `zustand` is the POST-transition state:
    --    the packet promoting NEW -> ESTABLISHED answers 2, exactly like a
    --    packet on a long-established flow. The direction tells them apart:
    --    a forward hit on NEW answers 1 and a fresh entry answers 1, so a
    --    forward packet answering 2 was ESTABLISHED before this packet --
    --    only that shape skips the rules. A reverse packet answering 2 may
    --    be the promotion itself and always walks the rules below. The old
    --    shape (`zustand == BESTEHEND` alone) ACCEPTed the promoting packet
    --    unseen; the E2 recipe in BEFUNDE-bm8.md F5 (SYN to a dropped port,
    --    then a spoofed reply) is the regression test.
    if zustand == BESTEHEND && richtung == 0 {
        zaehle_urteil(NIMM_AN);
        return NIMM_AN;
    }
    -- 5. Rules. State 0 means the bucket was full and the flow was
    --    refused (the table's `voll` counter already ran): surface the
    --    event on the counters lane too, then fall through to the rules
    --    -- fail closed, the default policy DROP decides.
    if zustand == FREI {
        zaehle_voll();
    }
    let urteil : u32 in 0 .. 2 = entscheide_regeln(proto, quelle, ziel, qport, zport, flaggen);
    -- 6. Count. The verdict always; the rule hit only when a rule
    --    matched (256 = default policy, no slot to count). The second
    --    walk can disagree with the first only if the table changed
    --    between them; the loader runs before the workers start, so both
    --    walks read the same table and the verdict stays authoritative.
    --    (`zaehle_regel` stands inside the branch: writes inside a branch
    --    do not taint past the join (M147) -- measured in BEFUNDE-bm8.md F2.)
    let treffer : u32 in 0 .. 256 = treffer_index(proto, quelle, ziel, qport, zport, flaggen);
    if treffer <= 255 {
        zaehle_regel(treffer);
    }
    return zaehle_weiter(urteil);
}

