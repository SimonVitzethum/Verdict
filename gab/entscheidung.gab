reads REGEL242, writes REGEL242, reads REGEL243, writes REGEL243, reads REGEL244, writes REGEL244, reads REGEL245, writes REGEL245, reads REGEL246, writes REGEL246, reads REGEL247, writes REGEL247, reads REGEL248, writes REGEL248, reads REGEL249, writes REGEL249, reads REGEL250, writes REGEL250, reads REGEL251, writes REGEL251, reads REGEL252, writes REGEL252, reads REGEL253, writes REGEL253, reads REGEL254, writes REGEL254, reads REGEL255, writes REGEL255, reads REGELSUMME, writes REGELSUMME };
extern fn zaehle_fehl()
    effects { reads FEHLFORM, writes FEHLFORM };
extern fn zaehle_voll()
    effects { reads VOLL, writes VOLL };

const DROP : u32 in 0 .. 2 = 0;
const NIMM_AN : u32 in 0 .. 2 = 1;
const FREI : u32 in 0 .. 3 = 0;
const BESTEHEND : u32 in 0 .. 3 = 2;
const KEIN_TREFFER : u32 in 0 .. 256 = 256;

-- The packet-count clock (see BEFUNDE-bm8.md F3): one saturating atomic,
-- bumped once per decided packet, handed to the connection table as
-- `jetzt`. Saturating, not wrapping: after a wrap `jetzt < gesehen`
-- would pin every entry (the clock-stepped-back rule), while a frozen
-- maximum keeps expiry working and only stops ageing new flows further.
-- A lost bump under contention re-reads as the same value -- time runs
-- slow, never backwards; monotonicity is what `altere` needs.
-- `pub`: the verdict function names it in `effects`, and an interface
-- that names something must explain it (N038) -- same rule as the
-- counters lane's own atomics.
pub atomic UHR_TICK : u32 relaxed;

-- One tick: saturating increment, answer the fresh value. The answer is
-- re-read AFTER the store (V4): `t` was derived from UHR_TICK before the
-- write, so no use of `t` may stand past it -- the checker is
-- path-insensitive here (M147) and so is this function.
impl fn tick() -> u32
    effects { reads UHR_TICK, writes UHR_TICK }
    costs <= 10 ops
{
    let t : u32 = UHR_TICK;
    if t < u32::max {
        UHR_TICK = t + 1 publishes nothing;
    }
    let frisch : u32 = UHR_TICK;
    return frisch;
}

-- Progress for the hit-index loop below: the walk ends after finitely many
-- passes -- at the first hit or at slot 256. Same shape as the startup
-- loops in gab/lauf.gab (a plain `retry` lowers to no C in this binary --
-- BEFUNDE-bm7.md L-3 -- and `traverse` over the rule table cannot stand
-- here: the table lives in another unit and the emitter resolves the bound
-- against a declaration it cannot see -- BEFUNDE-bm9.md B-2). The counter
-- and the `leave` stand in the body instead of in the loop form; the
-- comment at the loop says so.
assume treffer_suche_endet
    "Die Treffersuche endet nach endlich vielen Durchgaengen: beim ersten passenden Slots oder hinter Slot 255."
    falsifier sonde_treffer_suche;

impl fn sonde_treffer_suche() -> bool
    effects { pure }
{
    return true;
}

-- Watchdog for the bounded loop. Diverging, as the bound demands: when the
-- bound is exhausted the process does not carry on with a number that meant
-- nothing (same shape as `zaehler_streit` in gab/zaehler.gab).
extern fn treffer_aufgegeben() -> never effects { diverges };

-- Which rule would `entscheide_regeln` have matched first: the same walk,
-- returning the slot instead of the verdict, 256 when nothing matches.
-- The loop counts 0..256 by hand (`k` doubles as the slot index for the
-- `passt` mirror -- plain `u32`, C-identical to `index into Regel` -- and
-- the `k >= 256` guard ahead of the call IS the index proof the mirror
-- cannot carry). No `costs` line: the body calls an `extern` (K003).
impl fn treffer_index(proto : u32 in 0 .. 255, quelle : u32, ziel : u32, qport : u32 in 0 .. 65535, zport : u32 in 0 .. 65535, flaggen : u32 in 0 .. 255) -> u32 in 0 .. 256
    effects { reads Regel, reads Regel.slots }
{
    let mut k : u32 in 0 .. 256 = 0;
    let mut antwort : u32 in 0 .. 256 = KEIN_TREFFER;
    forever suche
        per_pass bounded 64 ops
        on_exceeded treffer_aufgegeben
        effects { reads Regel, reads Regel.slots }
        progress treffer_suche_endet
    {
        if k >= 256 {
            leave suche;
        }
        if passt(k, proto, quelle, ziel, qport, zport, flaggen) == 1 {
            antwort = k;
            leave suche;
        }
        if k < 256 {
            k += 1;
        } else {
            leave suche;
        }
    }
    return antwort;
}

-- Count a verdict and hand it back for the return. This helper exists for
-- a checker rule, not for the firewall: a value answered by a call with
-- write effects may not be USED after a straight-line call with write
-- effects (M147 -- measured in messung/BEFUNDE-bm8.md F2, where even
-- `zaehle_urteil(DROP); return urteil;` falls). Counting the verdict and
-- then returning it is therefore not writable as two lines in `entscheide`;
-- the parameter of a LOCAL helper carries no such taint, so the two lines
-- stand here instead. Same value counted, same value returned -- the shape
-- changed, the semantics did not. No `costs` line: the body calls an
-- `extern` (K003).
impl fn zaehle_weiter(u : u32 in 0 .. 2) -> u32 in 0 .. 2
    effects { reads VERWORFEN, writes VERWORFEN, reads AKZEPTIERT, writes AKZEPTIERT, reads ABGEWIESEN, writes ABGEWIESEN, reads GESAMT, writes GESAMT }
{
    zaehle_urteil(u);
    return u;
}

-- The one function the driver calls per packet. No `costs` line: every
-- callee but `tick` is an `extern` (K003). The worst case was last composed
-- by lane bm8 (91166 ops -- BERICHT-bm8.md); the second rule walk now runs
-- as a counted `forever` loop, whose per-pass bound (64 ops) over at most
-- 257 passes is the same shape of honest, only spelled where the checker
-- can see it from one file.
pub impl fn entscheide(laenge : u32 in 0 .. 1600, faden : u32 in 0 .. 15) -> u32 in 0 .. 2
    effects { reads Paket.slots, writes Kopf.slots, reads Kopf.slots, reads UHR_TICK, writes UHR_TICK, reads Verbindung.slots, writes Verbindung.slots, reads Stand.slots, writes Stand.slots, locks VSPERRE, reads Regel, reads Regel.slots, reads VERWORFEN, writes VERWORFEN, reads AKZEPTIERT, writes AKZEPTIERT, reads ABGEWIESEN, writes ABGEWIESEN, reads GESAMT, writes GESAMT, reads REGEL000, writes REGEL000, reads REGEL001, writes REGEL001, reads REGEL002, writes REGEL002, reads REGEL003, writes REGEL003, reads REGEL004, writes REGEL004, reads REGEL005, writes REGEL005, reads REGEL006, writes REGEL006, reads REGEL007, writes REGEL007, reads REGEL008, writes REGEL008, reads REGEL009, writes REGEL009, reads REGEL010, writes REGEL010, reads REGEL011, writes REGEL011, reads REGEL012, writes REGEL012, reads REGEL013, writes REGEL013, reads REGEL014, writes REGEL014, reads REGEL015, writes REGEL015, reads REGEL016, writes REGEL016, reads REGEL017, writes REGEL017, reads REGEL018, writes REGEL018, reads REGEL019, writes REGEL019, reads REGEL020, writes REGEL020, reads REGEL021, writes REGEL021, reads REGEL022, writes REGEL022, reads REGEL023, writes REGEL023, reads REGEL024, writes REGEL024, reads REGEL025, writes REGEL025, reads REGEL026, writes REGEL026, reads REGEL027, writes REGEL027, reads REGEL028, writes REGEL028, reads REGEL029, writes REGEL029, reads REGEL030, writes REGEL030, reads REGEL031, writes REGEL031, reads REGEL032, writes REGEL032, reads REGEL033, writes REGEL033, reads REGEL034, writes REGEL034, reads REGEL035, writes REGEL035, reads REGEL036, writes REGEL036, reads REGEL037, writes REGEL037, reads REGEL038, writes REGEL038, reads REGEL039, writes REGEL039, reads REGEL040, writes REGEL040, reads REGEL041, writes REGEL041, reads REGEL042, writes REGEL042, reads REGEL043, writes REGEL043, reads REGEL044, writes REGEL044, reads REGEL045, writes REGEL045, reads REGEL046, writes REGEL046, reads REGEL047, writes REGEL047, reads REGEL048, writes REGEL048, reads R