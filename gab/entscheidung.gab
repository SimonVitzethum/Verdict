-- gab/entscheidung.gab -- lane bm8: the per-packet decision wiring.
--
-- Five modules exist and check clean; this file owns none of their tables
-- and duplicates none of them. It owns exactly one function, `entscheide`,
-- the one the driver calls per packet, plus two small helpers:
-- `tick` (the packet-count clock) and `treffer_index` (the rule-hit lookup
-- for the counters). Every callee is named through an item-level `use`
-- line; the composition is checked as a unit (`pruefe --unit` over this
-- file plus the five owners, or `pruefe --with` their `.gabi`
-- interfaces -- see messung/BERICHT-bm8.md). A lone `pruefe` of this file
-- cannot resolve the `use` lines (M119/H021/K003); that is the unit
-- boundary, not a defect of this module (see messung/BEFUNDE-bm8.md F1).
--
-- THE POLICY, in wire order. The order below IS the firewall's policy:
--   1. decode (`entpacke`); a malformed packet is counted (`zaehle_fehl`
--      AND `zaehle_urteil(DROP)`, so GESAMT still counts every packet) and
--      DROPped. No rule is consulted for a packet we could not read.
--   2. look the flow up (`suche_oder_lege_an`) with the decoded tuple and
--      the current time, under `VSPERRE` -- the only statements inside the
--      `locks` block are the lookup and its assignment, so the critical
--      section is exactly one table operation.
--   3. an ESTABLISHED flow (state 2) takes the fast path: ACCEPT without
--      walking the rules. See the comment at the branch for why that is
--      the right semantics and what it costs when rules change at runtime.
--   4. otherwise walk the rules (`entscheide_regeln`); the default policy
--      (`STANDARD`, DROP -- owned by regeln.gab, not repeated here)
--      decides when nothing matches. A refused lookup (state 0: the
--      bucket was full) also lands here -- fail closed -- after surfacing
--      the event through `zaehle_voll`.
--   5. count the verdict (`zaehle_urteil`, exactly once per call, so
--      GESAMT == VERWORFEN + AKZEPTIERT + ABGEWIESEN holds by construction)
--      and, when a rule matched, the rule hit (`zaehle_regel`).
--
-- WHAT THIS FILE CANNOT DO (each with its reason in messung/BEFUNDE-bm8.md):
-- * `entscheide_regeln` answers the verdict but not WHICH rule matched, so
--   the hit index comes from a second walk (`treffer_index` over `passt`).
--   Worst-case cost is two full rule walks; the number stands in `costs`.
-- * no wall clock reaches this file (`zeit_lesen` needs a memory address
--   the language cannot name), so `jetzt` is a saturating packet counter,
--   not seconds: entries expire after 300 unobserved PACKETS, not 300 s.
-- * `Kopf`/`Paket` have count 1 shared by all threads, so `faden` cannot
--   index a per-thread buffer; it is boundary-checked and otherwise unused.

module brandmauer::entscheidung {

use brandmauer::pakete::Kopf;
use brandmauer::pakete::entpacke;
use brandmauer::regeln::Regel;
use brandmauer::regeln::entscheide_regeln;
use brandmauer::regeln::passt;
use brandmauer::verbindungen::VSPERRE;
use brandmauer::verbindungen::suche_oder_lege_an;
use brandmauer::zaehler::zaehle_urteil;
use brandmauer::zaehler::zaehle_regel;
use brandmauer::zaehler::zaehle_fehl;
use brandmauer::zaehler::zaehle_voll;

-- Verdicts after ARCHITEKTUR.md, connection states after verbindungen.gab
-- (0 frei, 1 NEU, 2 BESTEHEND, 3 SCHLIESSEND), KEIN_TREFFER marks "no rule
-- matched -- the default policy decided" for the counters.
const DROP : u32 in 0 .. 2 = 0;
const NIMM_AN : u32 in 0 .. 2 = 1;
const FREI : u32 in 0 .. 3 = 0;
const BESTEHEND : u32 in 0 .. 3 = 2;
const KEIN_TREFFER : u32 in 0 .. 256 = 256;

-- The packet-count clock (see BEFUNDE-bm8.md F3): one saturating atomic,
-- bumped once per decided packet, handed to the connection table as
-- `jetzt`. Saturating, not wrapping: after a wrap `jetzt < gesehen`
-- would pin every entry (the clock-stepped-back rule), while a frozen
-- maximum keeps expiry working and only stops ageing new flows further.
-- A lost bump under contention re-reads as the same value -- time runs
-- slow, never backwards; monotonicity is what `altere` needs.
-- `pub`: the verdict function names it in `effects`, and an interface
-- that names something must explain it (N038) -- same rule as the
-- counters lane's own atomics.
pub atomic UHR_TICK : u32 relaxed;

-- One tick: saturating increment, answer the fresh value. The answer is
-- re-read AFTER the store (V4): `t` was derived from UHR_TICK before the
-- write, so no use of `t` may stand past it -- the checker is
-- path-insensitive here (M147) and so is this function.
impl fn tick() -> u32
    effects { reads UHR_TICK, writes UHR_TICK }
    costs <= 10 ops
{
    let t : u32 = UHR_TICK;
    if t < u32::max {
        UHR_TICK = t + 1 publishes nothing;
    }
    let frisch : u32 = UHR_TICK;
    return frisch;
}

-- Which rule would `entscheide_regeln` have matched first: the same walk,
-- returning the slot instead of the verdict, 256 when nothing matches.
-- Early `return` out of the `traverse` body is the honest shape here
-- (first match wins -- nothing is left to do); a walk that must CONTINUE
-- after the find has no loop form (S001, see BEFUNDE-bm2.md).
impl fn treffer_index(proto : u32 in 0 .. 255, quelle : u32, ziel : u32, qport : u32 in 0 .. 65535, zport : u32 in 0 .. 65535, flaggen : u32 in 0 .. 255) -> u32 in 0 .. 256
    effects { reads Regel, reads Regel.slots }
    costs <= 20480 ops
{
    traverse k over slots of Regel by unvisited
        touches reads Regel, reads Regel.slots
    {
        if passt(k, proto, quelle, ziel, qport, zport, flaggen) == 1 {
            return k;
        }
    }
    return KEIN_TREFFER;
}

-- Count a verdict and hand it back for the return. This helper exists for
-- a checker rule, not for the firewall: a value answered by a FOREIGN call
-- (`entscheide_regeln`) may not be USED after a straight-line call with
-- write effects (M147 -- measured in messung/BEFUNDE-bm8.md F2, where even
-- `zaehle_urteil(DROP); return urteil;` falls). Counting the verdict and
-- then returning it is therefore not writable as two lines in `entscheide`;
-- the parameter of a LOCAL helper carries no such taint, so the two lines
-- stand here instead. Same value counted, same value returned -- the shape
-- changed, the semantics did not.
impl fn zaehle_weiter(u : u32 in 0 .. 2) -> u32 in 0 .. 2
    effects { reads VERWORFEN, writes VERWORFEN, reads AKZEPTIERT, writes AKZEPTIERT, reads ABGEWIESEN, writes ABGEWIESEN, reads GESAMT, writes GESAMT }
    costs <= 16 ops
{
    zaehle_urteil(u);
    return u;
}

-- The one function the driver calls per packet. Worst-case cost is the
-- sum over the callees' DECLARED bounds (a call counts what the callee
-- promises), measured as 91166 ops total, slack 0:
-- decode 200 + tick 10 + locked lookup block 520 (512 suche + block
-- overhead; the lock allows 1024) + rule walk 68096 + hit-index walk
-- 20480 (256 slots x 80: 71 passt + 9 walk overhead) + rule-hit count
-- 1797 + verdict count 16 + 47 own wiring (tuple loads, branches,
-- assignments). `gabbro kosten` computes the exact sum; the `costs`
-- line below is that number, not an estimate. An operator reading this:
-- 91166 ops is the worst-case per-packet work of the whole firewall.
pub impl fn entscheide(laenge : u32 in 0 .. 1600, faden : u32 in 0 .. 15) -> u32 in 0 .. 2
    effects { reads Paket.slots, writes Kopf.slots, reads Kopf.slots, reads UHR_TICK, writes UHR_TICK, reads Verbindung.slots, writes Verbindung.slots, reads Stand.slots, writes Stand.slots, locks VSPERRE, reads Regel, reads Regel.slots, reads VERWORFEN, writes VERWORFEN, reads AKZEPTIERT, writes AKZEPTIERT, reads ABGEWIESEN, writes ABGEWIESEN, reads GESAMT, writes GESAMT, reads REGEL000, writes REGEL000, reads REGEL001, writes REGEL001, reads REGEL002, writes REGEL002, reads REGEL003, writes REGEL003, reads REGEL004, writes REGEL004, reads REGEL005, writes REGEL005, reads REGEL006, writes REGEL006, reads REGEL007, writes REGEL007, reads REGEL008, writes REGEL008, reads REGEL009, writes REGEL009, reads REGEL010, writes REGEL010, reads REGEL011, writes REGEL011, reads REGEL012, writes REGEL012, reads REGEL013, writes REGEL013, reads REGEL014, writes REGEL014, reads REGEL015, writes REGEL015, reads REGEL016, writes REGEL016, reads REGEL017, writes REGEL017, reads REGEL018, writes REGEL018, reads REGEL019, writes REGEL019, reads REGEL020, writes REGEL020, reads REGEL021, writes REGEL021, reads REGEL022, writes REGEL022, reads REGEL023, writes REGEL023, reads REGEL024, writes REGEL024, reads REGEL025, writes REGEL025, reads REGEL026, writes REGEL026, reads REGEL027, writes REGEL027, reads REGEL028, writes REGEL028, reads REGEL029, writes REGEL029, reads REGEL030, writes REGEL030, reads REGEL031, writes REGEL031, reads REGEL032, writes REGEL032, reads REGEL033, writes REGEL033, reads REGEL034, writes REGEL034, reads REGEL035, writes REGEL035, reads REGEL036, writes REGEL036, reads REGEL037, writes REGEL037, reads REGEL038, writes REGEL038, reads REGEL039, writes REGEL039, reads REGEL040, writes REGEL040, reads REGEL041, writes REGEL041, reads REGEL042, writes REGEL042, reads REGEL043, writes REGEL043, reads REGEL044, writes REGEL044, reads REGEL045, writes REGEL045, reads REGEL046, writes REGEL046, reads REGEL047, writes REGEL047, reads REGEL048, writes REGEL048, reads REGEL049, writes REGEL049, reads REGEL050, writes REGEL050, reads REGEL051, writes REGEL051, reads REGEL052, writes REGEL052, reads REGEL053, writes REGEL053, reads REGEL054, writes REGEL054, reads REGEL055, writes REGEL055, reads REGEL056, writes REGEL056, reads REGEL057, writes REGEL057, reads REGEL058, writes REGEL058, reads REGEL059, writes REGEL059, reads REGEL060, writes REGEL060, reads REGEL061, writes REGEL061, reads REGEL062, writes REGEL062, reads REGEL063, writes REGEL063, reads REGEL064, writes REGEL064, reads REGEL065, writes REGEL065, reads REGEL066, writes REGEL066, reads REGEL067, writes REGEL067, reads REGEL068, writes REGEL068, reads REGEL069, writes REGEL069, reads REGEL070, writes REGEL070, reads REGEL071, writes REGEL071, reads REGEL072, writes REGEL072, reads REGEL073, writes REGEL073, reads REGEL074, writes REGEL074, reads REGEL075, writes REGEL075, reads REGEL076, writes REGEL076, reads REGEL077, writes REGEL077, reads REGEL078, writes REGEL078, reads REGEL079, writes REGEL079, reads REGEL080, writes REGEL080, reads REGEL081, writes REGEL081, reads REGEL082, writes REGEL082, reads REGEL083, writes REGEL083, reads REGEL084, writes REGEL084, reads REGEL085, writes REGEL085, reads REGEL086, writes REGEL086, reads REGEL087, writes REGEL087, reads REGEL088, writes REGEL088, reads REGEL089, writes REGEL089, reads REGEL090, writes REGEL090, reads REGEL091, writes REGEL091, reads REGEL092, writes REGEL092, reads REGEL093, writes REGEL093, reads REGEL094, writes REGEL094, reads REGEL095, writes REGEL095, reads REGEL096, writes REGEL096, reads REGEL097, writes REGEL097, reads REGEL098, writes REGEL098, reads REGEL099, writes REGEL099, reads REGEL100, writes REGEL100, reads REGEL101, writes REGEL101, reads REGEL102, writes REGEL102, reads REGEL103, writes REGEL103, reads REGEL104, writes REGEL104, reads REGEL105, writes REGEL105, reads REGEL106, writes REGEL106, reads REGEL107, writes REGEL107, reads REGEL108, writes REGEL108, reads REGEL109, writes REGEL109, reads REGEL110, writes REGEL110, reads REGEL111, writes REGEL111, reads REGEL112, writes REGEL112, reads REGEL113, writes REGEL113, reads REGEL114, writes REGEL114, reads REGEL115, writes REGEL115, reads REGEL116, writes REGEL116, reads REGEL117, writes REGEL117, reads REGEL118, writes REGEL118, reads REGEL119, writes REGEL119, reads REGEL120, writes REGEL120, reads REGEL121, writes REGEL121, reads REGEL122, writes REGEL122, reads REGEL123, writes REGEL123, reads REGEL124, writes REGEL124, reads REGEL125, writes REGEL125, reads REGEL126, writes REGEL126, reads REGEL127, writes REGEL127, reads REGEL128, writes REGEL128, reads REGEL129, writes REGEL129, reads REGEL130, writes REGEL130, reads REGEL131, writes REGEL131, reads REGEL132, writes REGEL132, reads REGEL133, writes REGEL133, reads REGEL134, writes REGEL134, reads REGEL135, writes REGEL135, reads REGEL136, writes REGEL136, reads REGEL137, writes REGEL137, reads REGEL138, writes REGEL138, reads REGEL139, writes REGEL139, reads REGEL140, writes REGEL140, reads REGEL141, writes REGEL141, reads REGEL142, writes REGEL142, reads REGEL143, writes REGEL143, reads REGEL144, writes REGEL144, reads REGEL145, writes REGEL145, reads REGEL146, writes REGEL146, reads REGEL147, writes REGEL147, reads REGEL148, writes REGEL148, reads REGEL149, writes REGEL149, reads REGEL150, writes REGEL150, reads REGEL151, writes REGEL151, reads REGEL152, writes REGEL152, reads REGEL153, writes REGEL153, reads REGEL154, writes REGEL154, reads REGEL155, writes REGEL155, reads REGEL156, writes REGEL156, reads REGEL157, writes REGEL157, reads REGEL158, writes REGEL158, reads REGEL159, writes REGEL159, reads REGEL160, writes REGEL160, reads REGEL161, writes REGEL161, reads REGEL162, writes REGEL162, reads REGEL163, writes REGEL163, reads REGEL164, writes REGEL164, reads REGEL165, writes REGEL165, reads REGEL166, writes REGEL166, reads REGEL167, writes REGEL167, reads REGEL168, writes REGEL168, reads REGEL169, writes REGEL169, reads REGEL170, writes REGEL170, reads REGEL171, writes REGEL171, reads REGEL172, writes REGEL172, reads REGEL173, writes REGEL173, reads REGEL174, writes REGEL174, reads REGEL175, writes REGEL175, reads REGEL176, writes REGEL176, reads REGEL177, writes REGEL177, reads REGEL178, writes REGEL178, reads REGEL179, writes REGEL179, reads REGEL180, writes REGEL180, reads REGEL181, writes REGEL181, reads REGEL182, writes REGEL182, reads REGEL183, writes REGEL183, reads REGEL184, writes REGEL184, reads REGEL185, writes REGEL185, reads REGEL186, writes REGEL186, reads REGEL187, writes REGEL187, reads REGEL188, writes REGEL188, reads REGEL189, writes REGEL189, reads REGEL190, writes REGEL190, reads REGEL191, writes REGEL191, reads REGEL192, writes REGEL192, reads REGEL193, writes REGEL193, reads REGEL194, writes REGEL194, reads REGEL195, writes REGEL195, reads REGEL196, writes REGEL196, reads REGEL197, writes REGEL197, reads REGEL198, writes REGEL198, reads REGEL199, writes REGEL199, reads REGEL200, writes REGEL200, reads REGEL201, writes REGEL201, reads REGEL202, writes REGEL202, reads REGEL203, writes REGEL203, reads REGEL204, writes REGEL204, reads REGEL205, writes REGEL205, reads REGEL206, writes REGEL206, reads REGEL207, writes REGEL207, reads REGEL208, writes REGEL208, reads REGEL209, writes REGEL209, reads REGEL210, writes REGEL210, reads REGEL211, writes REGEL211, reads REGEL212, writes REGEL212, reads REGEL213, writes REGEL213, reads REGEL214, writes REGEL214, reads REGEL215, writes REGEL215, reads REGEL216, writes REGEL216, reads REGEL217, writes REGEL217, reads REGEL218, writes REGEL218, reads REGEL219, writes REGEL219, reads REGEL220, writes REGEL220, reads REGEL221, writes REGEL221, reads REGEL222, writes REGEL222, reads REGEL223, writes REGEL223, reads REGEL224, writes REGEL224, reads REGEL225, writes REGEL225, reads REGEL226, writes REGEL226, reads REGEL227, writes REGEL227, reads REGEL228, writes REGEL228, reads REGEL229, writes REGEL229, reads REGEL230, writes REGEL230, reads REGEL231, writes REGEL231, reads REGEL232, writes REGEL232, reads REGEL233, writes REGEL233, reads REGEL234, writes REGEL234, reads REGEL235, writes REGEL235, reads REGEL236, writes REGEL236, reads REGEL237, writes REGEL237, reads REGEL238, writes REGEL238, reads REGEL239, writes REGEL239, reads REGEL240, writes REGEL240, reads REGEL241, writes REGEL241, reads REGEL242, writes REGEL242, reads REGEL243, writes REGEL243, reads REGEL244, writes REGEL244, reads REGEL245, writes REGEL245, reads REGEL246, writes REGEL246, reads REGEL247, writes REGEL247, reads REGEL248, writes REGEL248, reads REGEL249, writes REGEL249, reads REGEL250, writes REGEL250, reads REGEL251, writes REGEL251, reads REGEL252, writes REGEL252, reads REGEL253, writes REGEL253, reads REGEL254, writes REGEL254, reads REGEL255, writes REGEL255, reads REGELSUMME, writes REGELSUMME, reads FEHLFORM, writes FEHLFORM, reads VOLL, writes VOLL }
    costs <= 91166 ops
{
    -- The C driver stands outside the range system: the emitted signature
    -- takes plain uint32_t, so a wild thread id would arrive unchecked.
    -- `faden` has no per-thread buffer to index (Kopf count 1 -- see the
    -- file head), hence this check is its only use, and the counting
    -- invariant (exactly one `zaehle_urteil` per call) holds even here.
    if faden > 15 {
        zaehle_urteil(DROP);
        return DROP;
    }
    -- 1. Decode. Malformed: count it twice (FEHLFORM for the event,
    --    DROP for the verdict so GESAMT stays per-packet) and drop.
    --    No rule is consulted for a packet we could not read.
    let ok : u32 in 0 .. 1 = entpacke(laenge);
    if ok == 0 {
        zaehle_fehl();
        zaehle_urteil(DROP);
        return DROP;
    }
    -- The tuple, read AFTER the single Kopf write of this call (V4):
    -- every read below is fresh, and no later call on this path writes
    -- Kopf, so no name here can go stale (M147).
    let proto : u32 in 0 .. 255 = Kopf.slots[0].proto;
    let quelle : u32 = Kopf.slots[0].quelle;
    let ziel : u32 = Kopf.slots[0].ziel;
    let qport : u32 in 0 .. 65535 = Kopf.slots[0].qport;
    let zport : u32 in 0 .. 65535 = Kopf.slots[0].zport;
    let flaggen : u32 in 0 .. 255 = Kopf.slots[0].flaggen;
    -- 2. Flow lookup under the connection lock. The block holds exactly
    --    the lookup and its assignment: rule matching and counting stay
    --    outside the critical section (the rule table is read-only after
    --    startup, the counters are lock-free atomics).
    let jetzt : u32 = tick();
    let mut zustand : u32 in 0 .. 3 = FREI;
    locks VSPERRE {
        zustand = suche_oder_lege_an(quelle, ziel, qport, zport, proto, flaggen, jetzt);
    }
    -- 3. Fast path. A flow the table reports as ESTABLISHED was ACCEPTed
    --    packet by packet through the rules when it was NEW, in this
    --    direction and the reverse (the reply promotes 1 -> 2); re-walking
    --    256 rules for every segment of a bulk transfer buys nothing the
    --    first walk did not already decide. The price is stated, not
    --    hidden: a rule set reloaded at runtime does NOT apply to flows
    --    already ESTABLISHED -- they keep their ACCEPT until they close
    --    or age out. Live revocation needs a generation stamp (or a sweep
    --    that demotes on reload); until that exists the fast path is a
    --    documented lag, and the lag is fail-open for old flows.
    if zustand == BESTEHEND {
        zaehle_urteil(NIMM_AN);
        return NIMM_AN;
    }
    -- 4. Rules. State 0 means the bucket was full and the flow was
    --    refused (the table's `voll` counter already ran): surface the
    --    event on the counters lane too, then fall through to the rules
    --    -- fail closed, the default policy DROP decides.
    if zustand == FREI {
        zaehle_voll();
    }
    let urteil : u32 in 0 .. 2 = entscheide_regeln(proto, quelle, ziel, qport, zport, flaggen);
    -- 5. Count. The verdict always; the rule hit only when a rule
    --    matched (256 = default policy, no slot to count). The second
    --    walk can disagree with the first only if the table changed
    --    between them; the loader runs before the workers start, so both
    --    walks read the same table and the verdict stays authoritative.
    let treffer : u32 in 0 .. 256 = treffer_index(proto, quelle, ziel, qport, zport, flaggen);
    if treffer <= 255 {
        zaehle_regel(treffer);
    }
    return zaehle_weiter(urteil);
}

}
